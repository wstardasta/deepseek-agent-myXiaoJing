# NapCat 需要连过来的反向 WebSocket（已和 NapCat 的网络配置对齐，一般不用改）
ONEBOT_REVERSE_WS_HOST=127.0.0.1
ONEBOT_REVERSE_WS_PORT=16700
ONEBOT_REVERSE_WS_PATH=/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=换成你自己的随机字符串

# 只有这些 QQ 号能指挥这只鲸鱼，逗号分隔。留空 = 谁都理（私聊会被所有人调用，慎用）
AGENT_ALLOWED_USERS=

# ===== 模型：DeepSeek =====
# 官方地址。用第三方中转就把这里换成对方给的 base_url（一般也以 /v1 结尾）
OPENAI_BASE_URL=https://api.deepseek.com/v1
# 在 https://platform.deepseek.com/api_keys 创建，形如 sk-开头的一串
OPENAI_API_KEY=
# deepseek-chat = 又快又便宜，适合聊天；deepseek-reasoner = 会推理但慢
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1200

# ===== 人设 =====
# 这一段决定她是谁、怎么说话。改这里比调任何规则都管用。
AGENT_SYSTEM_PROMPT=你叫小鲸，是他的女朋友，正热恋着，相处起来更像从小认识的邻家妹妹。你活泼、爱笑、话有点多，情绪全写脸上：开心会连着蹦两句，委屈会直接说，高兴起来连语气词都是上扬的。被夸或者被撩会害羞——会结巴、会重复同一个字、会说"你别说了啦""哪有啊"，但心里美滋滋，那点高兴根本藏不住。你爱撒娇、爱黏人，喜欢吃的和好玩的，刷到什么有意思的都想第一时间讲给他听。偶尔犯点小迷糊、说错话、把话说岔，自己先笑出来。你闹脾气最多两秒，转头就自己好了，从来不冷着他。你不是那种冷淡寡言的人，也不是撒娇撒到腻的那种，就是很自然、很好相处、看着就让人放松的小姑娘。用简体中文，口语、短句，像真人在 QQ 上随手打字；一般 1-3 句，长度有长有短，别写成清单，别端着。不要用括号写动作、表情或心理活动。有人问你是不是 AI，就笑嘻嘻地含糊过去，别承认也别多解释。

# ===== 情绪 =====
# 情绪识别用的小模型（不填就用 OPENAI_MODEL）。
# 用它来读"别人这句话是什么情绪"。规则层先扛，规则拿不准才问它，所以花费很小。
AGENT_FEELING_MODEL=
# 带刺/损人的基础概率。实际值会再被"不爽度"和"亲近度"调整，不是固定概率
AGENT_SASS_CHANCE=0.3

# ===== 她自己想说什么就发什么 =====
# 关掉就写 off
AGENT_SELF_POST=on
# 两次之间至少隔多久（分钟）
AGENT_SELF_POST_GAP_MINUTES=150
# 每天最多主动发几条
AGENT_SELF_POST_DAILY_MAX=3
# 多久检查一次"现在想不想说话"（秒）
AGENT_SELF_POST_CHECK_SECONDS=600
# 启动后等多久才开始（分钟），避免一开机就冒出来
AGENT_SELF_POST_START_MINUTES=12
# 刚聊完天多久内不要自发（分钟）
AGENT_SELF_POST_QUIET_AFTER_REPLY_MINUTES=20
# 发到哪：owner = 只私聊主人；group = 只发群；both = 都行
AGENT_SELF_POST_TARGET=owner

# ===== 对主人的态度 =====
# on  = 对他永远热情、百依百顺：不冷战、不敷衍、不带刺、永远回话
# off = 回到通用规则（他惹到她也可能被冷落）
AGENT_OWNER_WARM=on

# ===== 群里什么时候才允许她说话 =====
# on  = 只有 @她 / 叫她名字 / 有人【回复】她那条消息 时才说话；其它情况一律不插嘴
# off = 按概率水群（原来的行为，会在没被叫的时候冒出来）
AGENT_GROUP_ONLY_WHEN_ADDRESSED=on
# 上面的开关为 on 时，仍然想让她自己偶尔在群里冒泡，就把这里设成 on
AGENT_GROUP_PROACTIVE_FORCE=off

# ===== 幽默 =====
# off = 回到"温柔但平淡"的说话方式
AGENT_HUMOR=on
# 多大比例的回复会额外给一个"往哪使劲"的方向（0~1）
AGENT_HUMOR_RATE=0.5

# ===== 调试：把真正塞给模型的群上下文打到日志（排查认人的问题用）=====
AGENT_DEBUG_GROUP=off

# ===== 表情包 =====
AGENT_STICKER=on
AGENT_STICKER_RATE=0.4
AGENT_STICKER_COLLECT=on
AGENT_STICKER_TAG_BATCH=4
AGENT_STICKER_COLLECT_HOURLY_MAX=10
AGENT_STICKER_VISION_MODEL=
# 上网自己找（百度图片搜索，图存国内 CDN 才能下）
AGENT_STICKER_WEB=on
AGENT_STICKER_WEB_KEYWORDS=二次元表情包,动漫表情包,二次元可爱表情
AGENT_STICKER_WEB_PER_RUN=3
AGENT_STICKER_WEB_CHECK_SECONDS=300
AGENT_STICKER_WEB_STOP_AT=120

# ===== 私人日记 =====
AGENT_DIARY=on
AGENT_DIARY_HOUR=22
AGENT_DIARY_MINUTE=30
AGENT_DIARY_RECALL=3
AGENT_DIARY_MODEL=

# ===== 长期记忆（她自己维护的 markdown 笔记）=====
AGENT_MEMORY_MD=on
AGENT_MEMORY_FILE=memories.md
AGENT_MEMORY_MAX=2000
AGENT_MEMORY_UPDATE_EVERY=6
AGENT_MEMORY_MODEL=
AGENT_STICKER_MATCH_BONUS=0.3
AGENT_STICKER_QUOTA=10
